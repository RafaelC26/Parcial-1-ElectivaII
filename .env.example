# Puerto donde queda escuchando el servidor Express
PORT=3000

# Cadena de conexion a MongoDB Atlas.
# Reemplaza usuario, password y el host de tu cluster.
MONGODB_URI=YOUR_MONGODB_ATLAS_URI

# Entorno de ejecucion: development | production
NODE_ENV=development

# Secreto usado para firmar la cookie de sesion (mensajes flash)
SESSION_SECRET=cambia-este-valor-por-uno-propio
