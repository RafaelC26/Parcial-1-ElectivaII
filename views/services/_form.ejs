<%
  /*
    Formulario compartido por "Nuevo servicio" y "Editar servicio".
    Recibe: accion, valores, vehiculos, conductores, tipos, estados, esEdicion.

    Las ayudas visuales (vista previa del vehículo, aviso de cupo, aviso de
    horario) son informativas. La validación que decide es la del backend.
  */
%>
<form method="POST" action="<%= accion %>" data-submit-once novalidate>

  <!-- ------------------------ Información del servicio ---------------------- -->
  <section class="card card--pad form-section">
    <h2 class="form-section__title">Información del servicio</h2>
    <p class="form-section__hint">Qué actividad institucional motiva el transporte.</p>

    <div class="form-grid">
      <div class="field">
        <label class="field__label" for="tipoServicio">
          Tipo de servicio <span class="field__required">*</span>
        </label>
        <select id="tipoServicio" name="tipoServicio" class="select" required>
          <option value="">Seleccionar tipo</option>
          <% tipos.forEach(function (tipo) { %>
            <option value="<%= tipo %>" <%= valores.tipoServicio === tipo ? "selected" : "" %>><%= tipo %></option>
          <% }); %>
        </select>
      </div>

      <div class="field">
        <label class="field__label" for="fecha">
          Fecha <span class="field__required">*</span>
        </label>
        <input type="date" id="fecha" name="fecha" class="input"
               value="<%= valores.fecha ? toDateInput(valores.fecha) : '' %>" required>
      </div>

      <div class="field">
        <label class="field__label" for="horaSalida">
          Hora de salida <span class="field__required">*</span>
        </label>
        <input type="time" id="horaSalida" name="horaSalida" class="input"
               value="<%= valores.horaSalida || '' %>" data-hora-salida required>
      </div>

      <div class="field">
        <label class="field__label" for="horaRegreso">
          Hora estimada de regreso <span class="field__required">*</span>
        </label>
        <input type="time" id="horaRegreso" name="horaRegreso" class="input"
               value="<%= valores.horaRegreso || '' %>" data-hora-regreso required>
        <span class="field__hint" data-horario-aviso hidden style="color:var(--danger)"></span>
      </div>

      <div class="field">
        <label class="field__label" for="origen">
          Lugar de origen <span class="field__required">*</span>
        </label>
        <input type="text" id="origen" name="origen" class="input"
               value="<%= valores.origen || 'Sogamoso' %>" placeholder="Sogamoso" required>
      </div>

      <div class="field">
        <label class="field__label" for="destino">
          Lugar de destino <span class="field__required">*</span>
        </label>
        <input type="text" id="destino" name="destino" class="input"
               value="<%= valores.destino || '' %>" placeholder="Tunja" required>
      </div>

      <div class="field field--full">
        <label class="field__label" for="descripcion">
          Descripción o motivo <span class="field__required">*</span>
        </label>
        <textarea id="descripcion" name="descripcion" class="textarea"
                  placeholder="Salida académica del programa de Ingeniería de Sistemas..."
                  required><%= valores.descripcion || "" %></textarea>
      </div>
    </div>
  </section>

  <!-- ------------------------------- Transporte ----------------------------- -->
  <section class="card card--pad form-section">
    <h2 class="form-section__title">Transporte</h2>
    <p class="form-section__hint">
      El sistema verifica el cupo, la disponibilidad y la vigencia de la licencia al guardar.
    </p>

    <div class="form-grid">
      <div class="field">
        <label class="field__label" for="pasajeros">
          Número de pasajeros <span class="field__required">*</span>
        </label>
        <div class="input-group">
          <input type="number" id="pasajeros" name="pasajeros" class="input"
                 value="<%= valores.pasajeros || '' %>" placeholder="32" min="1"
                 data-pasajeros required>
          <span class="input-group__suffix">personas</span>
        </div>
        <span class="field__hint" data-capacidad-aviso hidden style="color:var(--danger)"></span>
      </div>

      <div class="field">
        <label class="field__label" for="estado">Estado</label>
        <select id="estado" name="estado" class="select">
          <% estados.forEach(function (estado) { %>
            <option value="<%= estado %>"
              <%= (valores.estado || "Programado") === estado ? "selected" : "" %>><%= estado %></option>
          <% }); %>
        </select>
      </div>

      <div class="field field--full">
        <label class="field__label" for="vehiculo">
          Vehículo <span class="field__required">*</span>
        </label>
        <select id="vehiculo" name="vehiculo" class="select" data-vehicle-select required>
          <option value="">Seleccionar vehículo</option>
          <% vehiculos.forEach(function (vehiculo) { %>
            <option value="<%= vehiculo._id %>"
              data-nombre="<%= vehiculo.marca %> <%= vehiculo.modelo %>"
              data-placa="<%= vehiculo.placa %>"
              data-tipo="<%= vehiculo.tipo %>"
              data-capacidad="<%= vehiculo.capacidad %>"
              data-estado="<%= vehiculo.estado %>"
              <%= String(valores.vehiculo) === String(vehiculo._id) ? "selected" : "" %>>
              <%= vehiculo.placa %> — <%= vehiculo.marca %> <%= vehiculo.modelo %>
              (<%= vehiculo.capacidad %> pasajeros)
            </option>
          <% }); %>
        </select>

        <% if (vehiculos.length === 0) { %>
          <span class="field__hint" style="color:var(--danger)">
            No hay vehículos disponibles. Registra uno o revisa los que están en mantenimiento.
          </span>
        <% } %>

        <!-- Vista previa del vehículo seleccionado -->
        <div class="preview-card" data-vehicle-preview hidden>
          <div class="preview-card__icon">
            <i data-lucide="bus-front" style="width:20px;height:20px"></i>
          </div>
          <div class="preview-card__body">
            <div class="preview-card__title" data-preview-title></div>
            <div class="preview-card__meta">
              <span class="plate" data-preview-plate></span>
              <span data-preview-type></span>
              <span class="dot">·</span>
              <span data-preview-capacity></span>
            </div>
          </div>
          <span class="badge badge--success" data-preview-estado></span>
        </div>
      </div>

      <div class="field field--full">
        <label class="field__label" for="conductor">
          Conductor <span class="field__required">*</span>
        </label>
        <select id="conductor" name="conductor" class="select" required>
          <option value="">Seleccionar conductor</option>
          <% conductores.forEach(function (conductor) { %>
            <option value="<%= conductor._id %>"
              <%= String(valores.conductor) === String(conductor._id) ? "selected" : "" %>
              <%= conductor.licenciaVencida ? "disabled" : "" %>>
              <%= conductor.nombre %> — Licencia <%= conductor.categoriaLicencia %><%
                %><%= conductor.licenciaVencida ? " (vencida)" : "" %>
            </option>
          <% }); %>
        </select>

        <% if (conductores.length === 0) { %>
          <span class="field__hint" style="color:var(--danger)">
            No hay conductores activos. Registra uno para poder programar servicios.
          </span>
        <% } %>
      </div>
    </div>
  </section>

  <!-- ------------------------------ Responsable ----------------------------- -->
  <section class="card card--pad form-section">
    <h2 class="form-section__title">Responsable</h2>
    <p class="form-section__hint">Quién solicita y acompaña el transporte.</p>

    <div class="form-grid">
      <div class="field">
        <label class="field__label" for="responsable">
          Responsable <span class="field__required">*</span>
        </label>
        <input type="text" id="responsable" name="responsable" class="input"
               value="<%= valores.responsable || '' %>" placeholder="Ing. Juan Martínez" required>
      </div>

      <div class="field">
        <label class="field__label" for="telefonoResponsable">Teléfono del responsable</label>
        <input type="tel" id="telefonoResponsable" name="telefonoResponsable" class="input"
               value="<%= valores.telefonoResponsable || '' %>" placeholder="3104567890">
      </div>

      <div class="field field--full">
        <label class="field__label" for="observaciones">Observaciones</label>
        <textarea id="observaciones" name="observaciones" class="textarea"
                  placeholder="Información adicional sobre el servicio..."><%= valores.observaciones || "" %></textarea>
      </div>
    </div>

    <div class="form-actions">
      <a href="<%= esEdicion ? '/services/' + valores._id : '/services' %>" class="btn btn--secondary">Cancelar</a>
      <button type="submit" class="btn btn--primary">
        <%= esEdicion ? "Guardar cambios" : "Programar servicio" %>
      </button>
    </div>
  </section>
</form>
